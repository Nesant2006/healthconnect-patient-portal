@model IEnumerable<HealthConnect.Models.Doctor>
@{
    ViewData["Title"] = "Our Doctors";
    var specialties = ViewBag.Specialties as List<string> ?? new List<string>();
    var selectedSpecialty = ViewBag.SelectedSpecialty as string ?? "";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<!-- Hero -->
<section class="bg-gradient-to-br from-primary-600 to-secondary-700 text-white py-12 px-4">
    <div class="max-w-5xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">Meet Our Doctors</h1>
        <p class="text-primary-100 text-lg mb-8">Qualified specialists dedicated to your wellbeing.</p>

        <!-- Search + Filter -->
        <form asp-controller="Home" asp-action="Doctors" method="get"
              class="flex flex-col sm:flex-row gap-3 max-w-2xl mx-auto">
            <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-white/60 pointer-events-none">
                    <i class="fas fa-search text-sm"></i>
                </span>
                <input type="text" name="search" value="@searchTerm"
                       placeholder="Search by name or specialty..."
                       class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-white/15 border border-white/30
                              text-white placeholder-white/60 focus:outline-none focus:ring-2
                              focus:ring-white/50 transition" />
            </div>
            <select name="specialty"
                    class="px-4 py-2.5 rounded-xl bg-white/15 border border-white/30 text-white
                           focus:outline-none focus:ring-2 focus:ring-white/50 transition min-w-[160px]">
                <option value="" class="text-gray-900">All Specialties</option>
                @foreach (var sp in specialties)
                {
                    <option value="@sp" class="text-gray-900"
                            selected="@(sp == selectedSpecialty ? "selected" : null)">
                        @sp
                    </option>
                }
            </select>
            <button type="submit"
                    class="px-6 py-2.5 bg-white text-primary-700 font-semibold rounded-xl
                           hover:bg-primary-50 transition">
                <i class="fas fa-filter mr-2"></i>Filter
            </button>
        </form>
    </div>
</section>

<!-- Results -->
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Result count -->
    <div class="flex items-center justify-between mb-6">
        <p class="text-gray-600 dark:text-gray-400" aria-live="polite">
            Showing <span class="font-semibold text-gray-900 dark:text-white">@(Model?.Count() ?? 0)</span> doctor(s)
            @if (!string.IsNullOrEmpty(selectedSpecialty))
            {
                <span> in <span class="text-primary-600 dark:text-primary-400 font-medium">@selectedSpecialty</span></span>
            }
        </p>
        @if (!string.IsNullOrEmpty(selectedSpecialty) || !string.IsNullOrEmpty(searchTerm))
        {
            <a asp-controller="Home" asp-action="Doctors"
               class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
                <i class="fas fa-times mr-1"></i>Clear filters
            </a>
        }
    </div>

    @if (!Model?.Any() ?? true)
    {
        <div class="text-center py-16">
            <i class="fas fa-user-md text-5xl text-gray-300 dark:text-gray-600 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">No doctors found</h3>
            <p class="text-gray-500 dark:text-gray-500">Try adjusting your search or filter.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var doctor in Model!)
            {
                <div class="card p-6 flex flex-col hover:shadow-xl transition-shadow duration-300">
                    <!-- Avatar -->
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary-400
                                    to-secondary-500 flex items-center justify-center
                                    flex-shrink-0 shadow-md">
                            <span class="text-white text-xl font-bold">
                                @doctor.FullName.FirstOrDefault()
                            </span>
                        </div>
                        <div>
                            <h2 class="font-bold text-gray-900 dark:text-white">Dr. @doctor.FullName</h2>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs
                                         font-medium bg-primary-100 text-primary-800
                                         dark:bg-primary-900/40 dark:text-primary-300">
                                @doctor.Specialty
                            </span>
                        </div>
                    </div>

                    <!-- Rating -->
                    <div class="flex items-center gap-1 mb-3">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="fas fa-star text-sm @(i < Math.Round(doctor.Rating) ? "text-yellow-400" : "text-gray-200 dark:text-gray-600")"></i>
                        }
                        <span class="text-sm text-gray-500 dark:text-gray-400 ml-1">
                            @doctor.Rating.ToString("F1") (@doctor.ReviewCount reviews)
                        </span>
                    </div>

                    <!-- Details -->
                    <div class="space-y-1 mb-4 flex-1 text-xs text-gray-500 dark:text-gray-400">
                        @if (!string.IsNullOrEmpty(doctor.Qualifications))
                        {
                            <p><i class="fas fa-graduation-cap mr-2 text-primary-400"></i>@doctor.Qualifications</p>
                        }
                        @if (doctor.ExperienceYears > 0)
                        {
                            <p><i class="fas fa-briefcase mr-2 text-primary-400"></i>@doctor.ExperienceYears years experience</p>
                        }
                        @if (!string.IsNullOrEmpty(doctor.Languages))
                        {
                            <p><i class="fas fa-language mr-2 text-primary-400"></i>@doctor.Languages</p>
                        }
                    </div>

                    <!-- Fee + Book -->
                    <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
                        <div>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Consultation fee</p>
                            <p class="text-lg font-bold text-gray-900 dark:text-white">
                                $@doctor.ConsultationFee.ToString("F0")
                            </p>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Appointment" asp-action="Create"
                               asp-route-doctorId="@doctor.DoctorId"
                               class="btn-primary text-sm">
                                <i class="fas fa-calendar-plus mr-1"></i>Book
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="btn-primary text-sm">
                                <i class="fas fa-calendar-plus mr-1"></i>Book
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>