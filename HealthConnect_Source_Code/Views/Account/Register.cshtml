@model HealthConnect.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center px-4 py-12">
    <div class="max-w-lg w-full">

        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-heartbeat text-white text-2xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Create your account</h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1">Join HealthConnect today — it's free</p>
        </div>

        <div class="card p-8">
            <form asp-controller="Account" asp-action="Register"
                  method="post" class="space-y-5" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200
                            dark:border-red-800 p-4 text-red-800 dark:text-red-300 text-sm"></div>

                <!-- Full Name -->
                <div>
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                            <i class="fas fa-user text-sm"></i>
                        </span>
                        <input asp-for="FullName" class="form-input pl-10"
                               placeholder="Your full name" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="form-error"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                            <i class="fas fa-envelope text-sm"></i>
                        </span>
                        <input asp-for="Email" class="form-input pl-10"
                               placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <!-- Phone -->
<div>
    <label asp-for="Phone" class="form-label">Phone <span class="text-gray-400 font-normal text-xs">(Optional)</span></label>
    <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
            <i class="fas fa-phone text-sm"></i>
        </span>
        <input asp-for="Phone" class="form-input pl-10" placeholder="04xx xxx xxx" />
    </div>
    <span asp-validation-for="Phone" class="form-error"></span>
</div>

<!-- Date of Birth -->
<div>
    <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="text-gray-400 font-normal text-xs">(Optional)</span></label>
    <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
            <i class="fas fa-calendar text-sm"></i>
        </span>
        <input asp-for="DateOfBirth" type="date" class="form-input pl-10" />
    </div>
    <span asp-validation-for="DateOfBirth" class="form-error"></span>
</div>
                <!-- Gender -->
                <div>
                    <label asp-for="Gender" class="form-label">Gender <span class="text-gray-400 font-normal text-xs">(Optional)</span></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Prefer not to say</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Non-binary">Non-binary</option>
                    </select>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                            <i class="fas fa-lock text-sm"></i>
                        </span>
                        <input asp-for="Password" type="password" id="passwordInput"
                               class="form-input pl-10 pr-10"
                               placeholder="Min. 8 characters" autocomplete="new-password" />
                        <button type="button" id="togglePassword"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
                                aria-label="Show or hide password">
                            <i class="fas fa-eye text-sm" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="form-error"></span>

                    <!-- Password strength -->
                    <div class="mt-2">
                        <div class="flex gap-1 mb-1">
                            <div class="h-1 flex-1 rounded-full bg-gray-200 dark:bg-gray-700" id="s1"></div>
                            <div class="h-1 flex-1 rounded-full bg-gray-200 dark:bg-gray-700" id="s2"></div>
                            <div class="h-1 flex-1 rounded-full bg-gray-200 dark:bg-gray-700" id="s3"></div>
                            <div class="h-1 flex-1 rounded-full bg-gray-200 dark:bg-gray-700" id="s4"></div>
                        </div>
                        <p class="text-xs text-gray-400" id="strengthText">Enter a password</p>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                            <i class="fas fa-lock text-sm"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" id="confirmInput"
                               class="form-input pl-10"
                               placeholder="Repeat your password" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                    <p class="text-xs mt-1 hidden" id="matchMsg"></p>
                </div>

                <button type="submit" class="btn-primary w-full py-3 text-base">
                    <i class="fas fa-user-plus mr-2"></i>Create Account
                </button>
            </form>
        </div>

        <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
            Already have an account?
            <a asp-controller="Account" asp-action="Login"
               class="text-primary-600 dark:text-primary-400 font-medium hover:underline">
                Sign in here
            </a>
        </p>
    </div>
</div>

@section Scripts {
<script>
    // Password show/hide
    document.getElementById('togglePassword').addEventListener('click', function () {
        const input = document.getElementById('passwordInput');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    });

    // Password strength
    const pwd = document.getElementById('passwordInput');
    const bars = ['s1','s2','s3','s4'].map(id => document.getElementById(id));
    const strengthText = document.getElementById('strengthText');
    const levels = [
        { color: 'bg-red-500',    label: 'Weak' },
        { color: 'bg-orange-400', label: 'Fair' },
        { color: 'bg-yellow-400', label: 'Good' },
        { color: 'bg-green-500',  label: 'Strong' },
    ];

    pwd.addEventListener('input', function () {
        const v = this.value;
        let score = 0;
        if (v.length >= 8)  score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;

        bars.forEach((b, i) => {
            b.className = 'h-1 flex-1 rounded-full ' +
                (i < score ? levels[score - 1].color : 'bg-gray-200 dark:bg-gray-700');
        });
        strengthText.textContent = v.length === 0 ? 'Enter a password' : levels[Math.max(score-1,0)].label;
    });

    // Password match
    const confirm = document.getElementById('confirmInput');
    const matchMsg = document.getElementById('matchMsg');
    confirm.addEventListener('input', function () {
        if (this.value === '') { matchMsg.classList.add('hidden'); return; }
        matchMsg.classList.remove('hidden');
        if (this.value === pwd.value) {
            matchMsg.textContent = '✓ Passwords match';
            matchMsg.className = 'text-xs mt-1 text-green-600 dark:text-green-400';
        } else {
            matchMsg.textContent = '✗ Passwords do not match';
            matchMsg.className = 'text-xs mt-1 text-red-600 dark:text-red-400';
        }
    });
</script>
}