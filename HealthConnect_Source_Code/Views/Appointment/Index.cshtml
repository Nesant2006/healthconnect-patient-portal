@model IEnumerable<HealthConnect.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
    var search = ViewBag.SearchTerm as string ?? "";
    var status = ViewBag.StatusFilter as string ?? "";
    var sort   = ViewBag.Sort as string ?? "";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">My Appointments</h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1" aria-live="polite">
                <span class="font-semibold text-gray-700 dark:text-gray-300">@ViewBag.TotalCount</span> appointments found
            </p>
        </div>
        <a asp-controller="Appointment" asp-action="Create" class="btn-primary self-start sm:self-auto">
            <i class="fas fa-plus mr-2"></i>Book New
        </a>
    </div>

    <!-- Filters -->
    <div class="card p-4 mb-6">
        <form asp-controller="Appointment" asp-action="Index" method="get"
              class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                    <i class="fas fa-search text-sm"></i>
                </span>
                <input type="text" name="search" value="@search"
                       placeholder="Search doctor or reason..."
                       class="form-input pl-9" />
            </div>
            <select name="status" class="form-select sm:w-40">
                <option value="">All Statuses</option>
                @foreach (var s in new[] { "Pending","Confirmed","Completed","Cancelled" })
                {
                    <option value="@s" selected="@(s == status ? "selected" : null)">@s</option>
                }
            </select>
            <select name="sort" class="form-select sm:w-40">
                <option value="" selected="@(sort == "" ? "selected" : null)">Newest First</option>
                <option value="oldest" selected="@(sort == "oldest" ? "selected" : null)">Oldest First</option>
            </select>
            <div class="flex gap-2">
                <button type="submit" class="btn-primary text-sm px-5">
                    <i class="fas fa-filter mr-2"></i>Filter
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status))
                {
                    <a asp-controller="Appointment" asp-action="Index" class="btn-secondary text-sm px-4">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Desktop Table -->
    <div class="card overflow-hidden hidden md:block">
        <div class="overflow-x-auto">
            <table class="data-table" aria-label="Appointments table">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Urgent</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-gray-400 dark:text-gray-500">
                                <i class="fas fa-calendar-times text-4xl mb-3 block"></i>
                                No appointments found.
                            </td>
                        </tr>
                    }
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td>
                                <p class="font-medium text-gray-900 dark:text-white">Dr. @appt.DoctorName</p>
                                <p class="text-xs text-gray-400">@appt.Specialty</p>
                            </td>
                            <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@appt.AppointmentTime</td>
                            <td><span class="badge badge-@appt.Status.ToLower()">@appt.Status</span></td>
                            <td class="text-center">
                                @if (appt.IsUrgent)
                                {
                                    <span class="badge badge-urgent">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>Urgent
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <a asp-controller="Appointment" asp-action="Details"
                                       asp-route-id="@appt.AppointmentId"
                                       class="text-primary-600 dark:text-primary-400 hover:underline text-xs">
                                        View
                                    </a>
                                    @if (appt.Status == "Pending" || appt.Status == "Confirmed")
                                    {
                                        <a asp-controller="Appointment" asp-action="Edit"
                                           asp-route-id="@appt.AppointmentId"
                                           class="text-gray-500 dark:text-gray-400 hover:underline text-xs">
                                            Edit
                                        </a>
                                        <form asp-controller="Appointment" asp-action="Cancel"
                                              method="post" class="inline"
                                              onsubmit="return confirm('Cancel this appointment?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                                            <button type="submit"
                                                    class="text-red-500 dark:text-red-400 hover:underline text-xs">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-4">
        @if (!Model.Any())
        {
            <div class="card p-10 text-center text-gray-400 dark:text-gray-500">
                <i class="fas fa-calendar-times text-4xl mb-3 block"></i>
                No appointments found.
            </div>
        }
        @foreach (var appt in Model)
        {
            <div class="card p-4">
                <div class="flex items-start justify-between gap-2 mb-3">
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">Dr. @appt.DoctorName</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">@appt.Specialty</p>
                    </div>
                    <div class="flex flex-col items-end gap-1">
                        <span class="badge badge-@appt.Status.ToLower()">@appt.Status</span>
                        @if (appt.IsUrgent)
                        {
                            <span class="badge badge-urgent text-xs">Urgent</span>
                        }
                    </div>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                    <i class="fas fa-calendar mr-1"></i>@appt.AppointmentDate.ToString("dd MMM yyyy")
                    at @appt.AppointmentTime
                </p>
                <div class="flex gap-2 pt-3 border-t border-gray-100 dark:border-gray-700">
                    <a asp-controller="Appointment" asp-action="Details"
                       asp-route-id="@appt.AppointmentId"
                       class="btn-secondary text-xs flex-1 text-center">
                        <i class="fas fa-eye mr-1"></i>View
                    </a>
                    @if (appt.Status == "Pending" || appt.Status == "Confirmed")
                    {
                        <a asp-controller="Appointment" asp-action="Edit"
                           asp-route-id="@appt.AppointmentId"
                           class="btn-secondary text-xs flex-1 text-center">
                            <i class="fas fa-edit mr-1"></i>Edit
                        </a>
                        <form asp-controller="Appointment" asp-action="Cancel" method="post"
                              class="flex-1" onsubmit="return confirm('Cancel this appointment?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@appt.AppointmentId" />
                            <button type="submit" class="btn-danger text-xs w-full">
                                <i class="fas fa-times mr-1"></i>Cancel
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>